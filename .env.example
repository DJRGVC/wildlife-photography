# Cloudflare R2 — originals storage
# Dashboard: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
# Token needs Object Read & Write on the bucket below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wildlife-photography-originals
# Prefix inside the bucket where originals live
R2_PREFIX=photos/

# Cloudflare API token — used by `wrangler pages deploy` to push the built
# site to Cloudflare Pages. Get one at:
#   dash.cloudflare.com -> Manage Account -> Account API Tokens -> Create Token
#   Use the "Cloudflare Pages: Edit" template scoped to your account.
CLOUDFLARE_API_TOKEN=

# Anthropic API key for the caption editor's vision-based auto-classify of
# newly uploaded photos. Get one at:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
