# Cloudflare R2 — originals storage
# Dashboard: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
# Token needs Object Read & Write on the bucket below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wildlife-photography-originals
# Prefix inside the bucket where originals live
R2_PREFIX=photos/
