---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Bio.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import Cursor from '../components/Cursor.astro';
import Gallery from '../components/Gallery';
import { loadGalleryPhotos } from '../lib/photos';

const { wildlife, misc } = await loadGalleryPhotos();
const lcpSrc = wildlife[0]?.src ?? misc[0]?.src;
---

<Base lcpImage={lcpSrc}>
  <a id="top" tabindex="-1" aria-hidden="true"></a>
  <Header />
  <main>
    <Intro />
    <Gallery client:visible wildlife={wildlife} misc={misc} />
    <Contact />
  </main>
  <Footer />
  <SmoothScroll />
  <Cursor />
</Base>
