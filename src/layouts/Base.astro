---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lcpImage?: string;
}

const {
  title = 'Daniel Grant',
  description = 'Photography by Daniel Grant — wildlife and miscellany, made with a Canon EOS R7.',
  lcpImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon-256.png?v=2" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FAFAF7" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
    />
    {lcpImage ? <link rel="preload" as="image" href={lcpImage} fetchpriority="high" /> : null}
  </head>
  <body>
    <slot />
  </body>
</html>
