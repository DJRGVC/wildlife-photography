---
const name = 'Daniel Grant';
const nameChars = [...name];
const navLabel = 'Contact';
const navChars = [...navLabel];

// Animation = 280ms; cascade window = 220ms; total per cascade = 500ms.
// Stagger computed per-element so the cascade fits regardless of
// letter count.
const CASCADE_WINDOW_MS = 700;
const ANIM_MS = 900;
const nameStagger =
  nameChars.length > 1 ? CASCADE_WINDOW_MS / (nameChars.length - 1) : 0;
const navStagger =
  navChars.length > 1 ? CASCADE_WINDOW_MS / (navChars.length - 1) : 0;
// Nav "Contact" cascades in parallel with the rest of the page —
// starts at t=0 alongside the gallery images.
const NAV_BASE_MS = 0;
---

<div id="header-sentinel" aria-hidden="true"></div>
<header id="site-header" class="site-header">
  <div class="site-header__inner">
    <a
      href="#top"
      class="site-header__name"
      data-cursor="link"
      aria-label={name}
      style={`--stagger-ms:${nameStagger.toFixed(3)}ms`}
    >
      {
        nameChars.map((c, i) => (
          <span class="site-header__name-mask" style={`--i:${i}`} aria-hidden="true">
            <span class="site-header__name-reveal">{c === ' ' ? ' ' : c}</span>
          </span>
        ))
      }
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <a
        href="#contact"
        class="site-header__nav-link"
        data-cursor="link"
        aria-label={navLabel}
        style={`--stagger-ms:${navStagger.toFixed(3)}ms; --base-ms:${NAV_BASE_MS}ms`}
      >
        {
          navChars.map((c, i) => (
            <span class="site-header__nav-mask" style={`--i:${i}`} aria-hidden="true">
              <span class="site-header__nav-reveal">{c}</span>
            </span>
          ))
        }
      </a>
    </nav>
  </div>
</header>

<style>
  #header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    visibility: hidden;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-cream) 88%, transparent);
    backdrop-filter: blur(16px) saturate(135%);
    -webkit-backdrop-filter: blur(16px) saturate(135%);
    padding-block: 44px 32px;
    padding-inline: max(24px, calc((100% - var(--container-gallery)) / 2 + 24px));
    opacity: var(--header-opacity, 1);
    transform: translateY(calc((1 - var(--header-opacity, 1)) * -8px));
    transition: opacity 220ms ease, transform 220ms ease;
    will-change: opacity, transform;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
  }
  .site-header[aria-hidden="true"] {
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .site-header__name:hover {
    text-decoration: none;
  }

  /* Per-letter mask + slide-up reveal. The outer span clips a single
     line height; the inner span starts pushed below at translateY(120%)
     and animates to translateY(0). --i (set inline per letter from the
     chars array) and --stagger-ms (set on the link, computed to fit the
     full cascade in ~220ms) together drive a left-to-right wave. */
  .site-header__name-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: 1.05;
  }
  .site-header__name-reveal {
    display: inline-block;
    transform: translateY(120%);
    animation: nameReveal 900ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i, 0) * var(--stagger-ms, 0ms));
    white-space: pre;
  }
  @keyframes nameReveal {
    to { transform: translateY(0); }
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__nav-link {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in oklab, currentColor 45%, transparent);
    transition:
      text-decoration-color 240ms ease,
      text-underline-offset 240ms ease;
  }

  .site-header__nav-link:hover,
  .site-header__nav-link:focus-visible {
    text-decoration-color: currentColor;
    text-underline-offset: 5px;
    outline: 0;
  }

  /* Same reveal primitive for the nav link, but offset by --base-ms so
     it starts after the name has finished cascading in. */
  .site-header__nav-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: 1;
  }
  .site-header__nav-reveal {
    display: inline-block;
    transform: translateY(120%);
    animation: navReveal 900ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--base-ms, 0ms) + var(--i, 0) * var(--stagger-ms, 0ms));
    white-space: pre;
  }
  @keyframes navReveal {
    to { transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .site-header {
      padding-block: 32px 28px;
    }
    .site-header__name {
      font-size: 22px;
    }
    .site-header__nav-link {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__name-reveal,
    .site-header__nav-reveal {
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const FADE_START = 40;
    const FADE_END = 200;
    let rafId: number | null = null;

    const update = () => {
      rafId = null;
      const sy = window.scrollY;
      const t = Math.min(1, Math.max(0, (sy - FADE_START) / (FADE_END - FADE_START)));
      const opacity = 1 - t;
      header.style.setProperty('--header-opacity', String(opacity));
      header.setAttribute('aria-hidden', opacity < 0.05 ? 'true' : 'false');
    };

    const onScroll = () => {
      if (rafId == null) rafId = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
