---
const name = 'Daniel Grant';
---

<div id="header-sentinel" aria-hidden="true"></div>
<header id="site-header" class="site-header">
  <div class="site-header__inner">
    <a href="#top" class="site-header__name">{name}</a>
    <nav class="site-header__nav" aria-label="Primary">
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  #header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    visibility: hidden;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-cream) 80%, transparent);
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    padding-block: 24px 20px;
    padding-inline: max(24px, calc((100% - var(--container-gallery)) / 2 + 24px));
    border-bottom: 1px solid transparent;
    opacity: var(--header-opacity, 1);
    transform: translateY(calc((1 - var(--header-opacity, 1)) * -8px));
    transition: opacity 220ms ease, transform 220ms ease;
    will-change: opacity, transform;
  }
  .site-header[aria-hidden="true"] {
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .site-header__name:hover {
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    gap: 24px;
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--color-ink-soft);
  }

  @media (max-width: 600px) {
    .site-header {
      padding-block: 20px 16px;
    }
    .site-header__name {
      font-size: 22px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const FADE_START = 40;
    const FADE_END = 200;
    let rafId: number | null = null;

    const update = () => {
      rafId = null;
      const sy = window.scrollY;
      const t = Math.min(1, Math.max(0, (sy - FADE_START) / (FADE_END - FADE_START)));
      const opacity = 1 - t;
      header.style.setProperty('--header-opacity', String(opacity));
      header.setAttribute('aria-hidden', opacity < 0.05 ? 'true' : 'false');
    };

    const onScroll = () => {
      if (rafId == null) rafId = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
