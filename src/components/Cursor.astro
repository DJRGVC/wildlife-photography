---
---

<div class="cursor" aria-hidden="true">
  <div class="cursor__ring"><span class="cursor__ring-label"></span></div>
  <div class="cursor__dot"></div>
</div>

<style>
  /* Two layers — a tight dot that's pinned to the cursor every
     pointermove, and a larger ring that chases via a rAF spring so it
     lags a few frames behind. The lag is the "magnetic" feel. Both
     blend via difference so they stay legible against cream OR a
     photograph without changing colour values. */
  .cursor {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    /* Hidden until the script has positioned the layers at least
       once; otherwise both elements flash at 0,0 on first paint. */
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .cursor.is-active { opacity: 1; }

  .cursor__dot,
  .cursor__ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    border-radius: 999px;
    /* Translate values are written by JS — keep the centering
       translate combined so JS doesn't have to recompute it. */
    will-change: transform;
  }

  /* The cursor's "ink" and "cream" tones are warm sepia/parchment
     to match the site's serif/cream aesthetic — never pure black or
     pure white. JS samples the pixel under the cursor on every frame
     and updates --cursor-color (the visible stroke) and --cursor-halo
     (the subtle outline that carries visibility against the opposite
     tone). Default state assumes a light background. */
  .cursor {
    --cursor-color: rgba(58, 46, 34, 0.92);
    --cursor-halo: rgba(250, 245, 232, 0.42);
  }

  .cursor__dot {
    width: 8px;
    height: 8px;
    background: var(--cursor-color);
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 1.5px var(--cursor-halo),
      0 1px 6px rgba(40, 30, 20, 0.22);
    transition:
      background-color 220ms ease,
      box-shadow 220ms ease;
  }

  .cursor__ring {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--cursor-color);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 1px var(--cursor-halo),
      0 4px 14px rgba(40, 30, 20, 0.16);
    transition:
      width 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease;
  }

  .cursor__ring[data-kind='link'] {
    width: 48px;
    height: 48px;
  }

  .cursor__ring[data-kind='photo'] {
    width: 84px;
    height: 84px;
    background: color-mix(in oklab, var(--cursor-color) 28%, transparent);
  }

  /* Label is over photo content; difference blend keeps it readable
     against any tone without needing to match the dynamic cursor
     color logic. */
  .cursor__ring-label {
    font-family: var(--font-serif, ui-serif);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5f0e4;
    mix-blend-mode: difference;
    opacity: 0;
    transform: translateY(1px);
    transition: opacity 220ms ease 60ms;
    pointer-events: none;
    white-space: nowrap;
  }
  .cursor__ring[data-kind='photo'] .cursor__ring-label {
    opacity: 1;
  }

  /* Hide the system cursor everywhere once the custom cursor is on.
     Body opts in by gaining the class once JS has confirmed this is a
     fine-pointer device. */
  body.has-magnetic-cursor,
  body.has-magnetic-cursor * {
    cursor: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { display: none; }
    body.has-magnetic-cursor,
    body.has-magnetic-cursor * {
      cursor: auto !important;
    }
  }
</style>

<script>
  // Magnetic cursor — fine-pointer devices only. Touch / coarse-pointer
  // devices fall back to no custom cursor (system pointer if any, or
  // nothing on phones).
  if (
    typeof window !== 'undefined' &&
    window.matchMedia('(pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const root = document.querySelector('.cursor') as HTMLDivElement | null;
    const dot = root?.querySelector('.cursor__dot') as HTMLDivElement | null;
    const ring = root?.querySelector('.cursor__ring') as HTMLDivElement | null;
    const ringLabel = root?.querySelector('.cursor__ring-label') as HTMLSpanElement | null;

    if (root && dot && ring && ringLabel) {
      document.body.classList.add('has-magnetic-cursor');

      // Position state lives in plain locals (NOT React state) so the
      // 120Hz pointermove path never triggers a render. tx/ty is the
      // current target (pinned to the actual cursor); rx/ry is where
      // the ring currently is, chasing toward tx/ty.
      const s = {
        tx: window.innerWidth / 2,
        ty: window.innerHeight / 2,
        rx: window.innerWidth / 2,
        ry: window.innerHeight / 2,
        active: false,
      };

      const SPRING = 0.18; // higher = tighter follow, 0.15–0.20 sweet spot

      const onPointerMove = (e: PointerEvent) => {
        s.tx = e.clientX;
        s.ty = e.clientY;
        // Dot: pinned to the cursor, written synchronously.
        dot.style.transform = `translate(${s.tx}px, ${s.ty}px) translate(-50%, -50%)`;
        if (!s.active) {
          // First move — sync ring to dot so it doesn't sweep in from
          // the corner, then reveal the cursor.
          s.rx = s.tx;
          s.ry = s.ty;
          s.active = true;
          root.classList.add('is-active');
        }
      };
      window.addEventListener('pointermove', onPointerMove, { passive: true });

      window.addEventListener('pointerleave', () => {
        root.classList.remove('is-active');
      });
      window.addEventListener('pointerenter', () => {
        if (s.active) root.classList.add('is-active');
      });

      // Hover state — the ring blooms and a label appears when over
      // an element marked with data-cursor. data-cursor-label sets
      // the text inside the ring.
      const onPointerOver = (e: PointerEvent) => {
        const t = (e.target as Element | null)?.closest('[data-cursor]') as HTMLElement | null;
        if (t) {
          ring.dataset.kind = t.dataset.cursor ?? '';
          ringLabel.textContent = t.dataset.cursorLabel ?? '';
        } else {
          ring.removeAttribute('data-kind');
          ringLabel.textContent = '';
        }
      };
      window.addEventListener('pointerover', onPointerOver);

      // Pixel sampling for dynamic cursor color. A 1x1 offscreen
      // canvas reads the colour under the cursor (drawImage for IMG
      // elements; computed background-color for everything else).
      // Luminance maps to either a warm walnut tone (on light bg) or
      // a warm cream tone (on dark bg) — both deliberately off
      // pure-black/pure-white to match the site's parchment aesthetic.
      // Throttled to ~30 Hz inside the existing rAF tick.
      const sampleCanvas = document.createElement('canvas');
      sampleCanvas.width = 1;
      sampleCanvas.height = 1;
      const sampleCtx = sampleCanvas.getContext('2d', {
        willReadFrequently: true,
      }) as CanvasRenderingContext2D | null;

      // Warm tones tuned to the site. Light ≈ #F5F0E4 (warm cream);
      // dark ≈ #3A2E22 (sepia walnut). Halos are the same tones at
      // low alpha so the cursor reads as "stroke + glow" rather than
      // a flat colour.
      const COLOR_LIGHT = { r: 245, g: 240, b: 228 };
      const COLOR_DARK = { r: 58, g: 46, b: 34 };

      type RGB = { r: number; g: number; b: number };

      const sampleBg = (x: number, y: number): RGB | null => {
        const el = document.elementFromPoint(x, y) as HTMLElement | null;
        if (!el) return null;

        // If the cursor is over an image, sample the actual pixel.
        const img =
          el.tagName === 'IMG'
            ? (el as HTMLImageElement)
            : el.querySelector?.('img');
        if (
          img instanceof HTMLImageElement &&
          img.complete &&
          img.naturalWidth > 0 &&
          sampleCtx
        ) {
          try {
            const rect = img.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
              const px = Math.max(0, Math.min(0.999, (x - rect.left) / rect.width));
              const py = Math.max(0, Math.min(0.999, (y - rect.top) / rect.height));
              const sx = Math.floor(px * img.naturalWidth);
              const sy = Math.floor(py * img.naturalHeight);
              sampleCtx.clearRect(0, 0, 1, 1);
              sampleCtx.drawImage(img, sx, sy, 1, 1, 0, 0, 1, 1);
              const data = sampleCtx.getImageData(0, 0, 1, 1).data;
              return { r: data[0], g: data[1], b: data[2] };
            }
          } catch {
            // CORS / tainted canvas / not decoded yet — fall through.
          }
        }

        // Walk up the DOM until we find a non-transparent background.
        let cur: Element | null = el;
        while (cur) {
          const bg = window.getComputedStyle(cur).backgroundColor;
          const m = bg.match(
            /rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)(?:\s*,\s*([\d.]+))?\s*\)/,
          );
          if (m) {
            const a = m[4] !== undefined ? parseFloat(m[4]) : 1;
            if (a > 0.05) {
              return {
                r: parseInt(m[1], 10),
                g: parseInt(m[2], 10),
                b: parseInt(m[3], 10),
              };
            }
          }
          cur = cur.parentElement;
        }
        return null;
      };

      const luminance = ({ r, g, b }: RGB) =>
        (0.299 * r + 0.587 * g + 0.114 * b) / 255;

      // Smoothed luminance with light hysteresis around the threshold,
      // so a cursor sitting right on the edge between light/dark
      // regions doesn't oscillate.
      let smoothedLum = 0.85; // start light
      const setColorsFor = (lum: number) => {
        smoothedLum = smoothedLum + (lum - smoothedLum) * 0.35;
        // Above ~0.5 = light bg → warm dark cursor; below = warm cream.
        const isDark = smoothedLum < 0.45;
        const c = isDark ? COLOR_LIGHT : COLOR_DARK;
        const halo = isDark ? COLOR_DARK : COLOR_LIGHT;
        root.style.setProperty(
          '--cursor-color',
          `rgba(${c.r}, ${c.g}, ${c.b}, 0.92)`,
        );
        root.style.setProperty(
          '--cursor-halo',
          `rgba(${halo.r}, ${halo.g}, ${halo.b}, 0.45)`,
        );
      };

      // Ring chases target via simple spring. Pixel sampling is done
      // every Nth frame so the work fits comfortably under a frame
      // budget even on slower devices.
      let raf = 0;
      let sampleCounter = 0;
      // Sample bg colour every 4th frame (~15Hz at 60fps). The drawImage
      // + getImageData round-trip is fast but not free; lower frequency
      // keeps main-thread work out of competition with concurrent
      // animations (notably the lightbox close FLIP).
      const SAMPLE_EVERY = 4;
      const tick = () => {
        // Full early-return during lightbox animations. The ring's
        // spring catches up the next time the lightbox is idle —
        // freezing it for ~520ms is invisible to the user but frees
        // 60Hz worth of main-thread work for the close FLIP.
        if (document.body.classList.contains('lb-animating')) {
          raf = requestAnimationFrame(tick);
          return;
        }
        s.rx += (s.tx - s.rx) * SPRING;
        s.ry += (s.ty - s.ry) * SPRING;
        ring.style.transform = `translate(${s.rx.toFixed(2)}px, ${s.ry.toFixed(2)}px) translate(-50%, -50%)`;
        if (s.active) {
          sampleCounter++;
          if (sampleCounter >= SAMPLE_EVERY) {
            sampleCounter = 0;
            const bg = sampleBg(s.tx, s.ty);
            if (bg) setColorsFor(luminance(bg));
          }
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);

      // Astro view-transitions / bfcache safety — stop the loop if the
      // page is being unloaded.
      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(raf);
        document.body.classList.remove('has-magnetic-cursor');
      });
    }
  }
</script>
