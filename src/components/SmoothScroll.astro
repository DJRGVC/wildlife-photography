<script>
  import Lenis from 'lenis';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function start(): Lenis | null {
    if (reduced.matches) return null;
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 0.95,
      touchMultiplier: 1.4,
    });
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    const onClick = (event: MouseEvent) => {
      const target = event.target as Element | null;
      const anchor = target?.closest('a[href^="#"]');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (!href || href === '#') return;
      const el = document.querySelector(href);
      if (!el) return;
      event.preventDefault();
      lenis.scrollTo(el as HTMLElement, { offset: -16, duration: 1.0 });
    };
    document.addEventListener('click', onClick);

    return lenis;
  }

  let instance = start();
  (window as unknown as { __lenis?: Lenis }).__lenis = instance ?? undefined;

  reduced.addEventListener('change', () => {
    if (reduced.matches && instance) {
      instance.destroy();
      instance = null;
      (window as unknown as { __lenis?: Lenis }).__lenis = undefined;
    } else if (!reduced.matches && !instance) {
      instance = start();
      (window as unknown as { __lenis?: Lenis }).__lenis = instance ?? undefined;
    }
  });

  // Scroll-driven page tone — bg color smoothly shifts from cream to warm tan
  // as the wildlife/misc separator approaches the viewport.
  let rafId: number | null = null;
  const root = document.documentElement;

  function updateTone() {
    rafId = null;
    const sep = document.querySelector('.gallery__sep') as HTMLElement | null;
    if (!sep) return;
    const rect = sep.getBoundingClientRect();
    const vh = window.innerHeight || 1;
    const center = rect.top + rect.height / 2;
    const t = 1 - Math.max(0, Math.min(1, center / vh));
    root.style.setProperty('--tone-mix', t.toFixed(3));
  }

  const onScroll = () => {
    if (rafId == null) rafId = requestAnimationFrame(updateTone);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  setTimeout(updateTone, 0);
</script>
