---
const para1 =
  'Occasionally, I venture outdoors and point my camera at things—often animals, but not exclusively.';
const para2 = 'Enjoy a selection of my favorites below.';
const para1Words = para1.split(' ');
const para2Words = para2.split(' ');
// Para 2 picks up after para 1's first word has finished its slide,
// so the reading cadence flows without empty pause but the second
// paragraph's first word doesn't race the first paragraph's last.
const PARA2_BASE_MS = 600;
---

<section class="intro">
  <p class="intro__line" aria-label={para1}>
    {
      para1Words.map((word, i, arr) => (
        <Fragment>
          <span class="intro__word-mask" style={`--i:${i}`} aria-hidden="true">
            <span class="intro__word-reveal">{word}</span>
          </span>
          {i < arr.length - 1 ? ' ' : ''}
        </Fragment>
      ))
    }
  </p>
  <p
    class="intro__line"
    aria-label={para2}
    style={`--para-base:${PARA2_BASE_MS}ms`}
  >
    {
      para2Words.map((word, i, arr) => (
        <Fragment>
          <span class="intro__word-mask" style={`--i:${i}`} aria-hidden="true">
            <span class="intro__word-reveal">{word}</span>
          </span>
          {i < arr.length - 1 ? ' ' : ''}
        </Fragment>
      ))
    }
  </p>
</section>

<style>
  .intro {
    padding-block: 40px 56px;
    padding-inline: max(24px, calc((100% - var(--container-gallery)) / 2 + 24px));
  }

  .intro p {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.45;
    color: var(--color-ink);
    margin: 0;
  }

  .intro p:first-child {
    white-space: nowrap;
  }

  .intro p + p {
    margin-top: 1.6em;
  }

  /* Per-word mask + slide-up reveal — same primitive as the header
     name, applied per word so the paragraph cascades left-to-right.
     Each word is its own overflow-hidden clip; the inner span starts
     pushed below at translateY(120%) and animates to rest. --i (set
     inline per word) drives the stagger; --para-base shifts the
     whole paragraph forward so the second one picks up after the
     first has gotten going. */
  .intro__line {
    --para-base: 0ms;
  }
  .intro__word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: inherit;
  }
  .intro__word-reveal {
    display: inline-block;
    transform: translateY(120%);
    animation: introWordReveal 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--para-base, 0ms) + var(--i, 0) * 70ms);
    white-space: pre;
  }
  @keyframes introWordReveal {
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__word-reveal {
      transform: none;
      animation: none;
    }
  }

  /* When the viewport is narrower than the gallery container can stay full
     width, let the first sentence wrap. Picks the breakpoint where
     Newsreader 18px ~100 chars stops fitting on one line. */
  @media (max-width: 1180px) {
    .intro p:first-child {
      white-space: normal;
    }
    .intro p {
      font-size: 17px;
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding-block: 24px 36px;
    }
    .intro p {
      font-size: 16px;
      line-height: 1.5;
    }
  }
</style>
