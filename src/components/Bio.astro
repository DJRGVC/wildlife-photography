<section class="intro">
  <p>
    Occasionally, I venture outdoors and point my camera at things&mdash;often
    animals, but not exclusively.
  </p>
  <p>Enjoy a selection of my favorites below.</p>
</section>

<style>
  .intro {
    padding-block: 40px 56px;
    padding-inline: max(24px, calc((100% - var(--container-gallery)) / 2 + 24px));
  }

  .intro p {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.45;
    color: var(--color-ink);
    margin: 0;
  }

  .intro p:first-child {
    white-space: nowrap;
  }

  .intro p + p {
    margin-top: 1.6em;
  }

  /* When the viewport is narrower than the gallery container can stay full
     width, let the first sentence wrap. Picks the breakpoint where
     Newsreader 18px ~100 chars stops fitting on one line. */
  @media (max-width: 1180px) {
    .intro p:first-child {
      white-space: normal;
    }
    .intro p {
      font-size: 17px;
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding-block: 24px 36px;
    }
    .intro p {
      font-size: 16px;
      line-height: 1.5;
    }
  }
</style>
