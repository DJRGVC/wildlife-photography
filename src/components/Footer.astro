---
const year = new Date().getFullYear();
const name = 'Daniel Grant';
---

<footer class="site-footer">
  <span>© {year} {name}</span>
  <span class="site-footer__sep" aria-hidden="true">·</span>
  <span>built with <a href="https://astro.build">Astro</a></span>
</footer>

<style>
  .site-footer {
    padding-block: 24px 40px;
    padding-inline: max(24px, calc((100% - var(--container-gallery)) / 2 + 24px));
    border-top: 1px solid var(--color-line);
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-ink-soft);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .site-footer__sep {
    opacity: 0.55;
  }
</style>
