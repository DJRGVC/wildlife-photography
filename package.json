{
  "name": "wildlife-photography",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names \"photos,astro\" --prefix-colors \"cyan,magenta\" \"npm:watch:photos\" \"npm:dev:astro\"",
    "dev:astro": "astro dev",
    "watch:photos": "tsx scripts/watch-photos.ts",
    "build:photos": "tsx scripts/build-photo-index.ts",
    "prebuild": "npm run build:photos",
    "build": "astro build",
    "build:cf": "tsx scripts/pull-photos.ts && npm run build:photos && astro build",
    "preview": "astro preview",
    "sync-portfolio": "tsx scripts/sync-portfolio.ts && npm run build:photos",
    "edit-captions": "tsx scripts/edit-captions.ts",
    "push-photos": "tsx scripts/push-photos.ts",
    "pull-photos": "tsx scripts/pull-photos.ts",
    "import-photos": "bash scripts/import-photos.sh",
    "tag-photo": "bash scripts/tag-photo.sh",
    "deploy": "wrangler pages deploy dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.5",
    "exifreader": "^4.39.0",
    "lenis": "^1.3.23",
    "mime-types": "^3.0.2",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-photo-album": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3"
  }
}
